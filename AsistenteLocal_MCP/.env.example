# === Autenticación (Microsoft Entra) ===
# App registration para un asistente local (device-code, sin client_secret).
TENANT_ID=
CLIENT_ID=

# --- Microsoft Graph (correo) ---
# Solo lectura de la bandeja + creación de borradores. NUNCA se envía correo.
GRAPH_USER_SCOPES=Mail.Read Mail.ReadWrite

# --- Dataverse (SOLO LECTURA / consulta) ---
# Deja vacío si no vas a consultar Dataverse todavía.
DATAVERSE_URL=
# Formato: https://<entorno>.crm.dynamics.com/.default
DATAVERSE_SCOPES=

# --- Registro local y reportes (rutas opcionales) ---
# SEGUIMIENTO_DIR=
# REPORTES_DIR=
